# Public application URL used for canonical metadata and secure links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production data/auth/storage (required to disable demo mode).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-in-host-secret-store

# Security integrations. Leave blank locally; never use placeholder values in production.
BOOKING_RATE_LIMIT_SECRET=
GUEST_LINK_SIGNING_SECRET=
UPLOAD_MALWARE_SCAN_WEBHOOK=

# Optional, only after the owner confirms these integrations and credentials.
EMAIL_PROVIDER_API_KEY=
ERROR_MONITORING_DSN=
ANALYTICS_ID=
